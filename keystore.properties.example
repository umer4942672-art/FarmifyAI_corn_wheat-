# Copy this file to keystore.properties and fill in your own values.
# keystore.properties is git-ignored; never commit a real keystore or its passwords.
#
# Create the keystore once with:
#   keytool -genkey -v -keystore farmify-release.jks -keyalg RSA \
#           -keysize 2048 -validity 10000 -alias farmify
#
storeFile=farmify-release.jks
storePassword=CHANGE_ME
keyAlias=farmify
keyPassword=CHANGE_ME
